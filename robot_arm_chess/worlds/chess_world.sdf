<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="arm_world">

    <!-- Physics -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sunlight -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Chess board:
        origin (a1 center) = (0.20, -0.175, 0.02)
        square_size = 0.045m
        board center = (0.3575, -0.0175, 0.01)

      All 64 squares are visuals inside this single model.
      Square poses are relative to the model origin (0.3575, -0.0175, 0.01).
        x_rel = -0.135 + rank_idx * 0.045   (rank_idx: 0=rank1 .. 7=rank8)
        y_rel = -0.135 + file_idx * 0.045   (file_idx: 0=a .. 7=h)
        z_rel = 0.011
      Color: light when (file_idx + rank_idx) is even, dark when odd.
    -->
    <model name="chess_board">
      <static>true</static>
      <pose>0.3575 -0.0175 0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.375 0.375 0.02</size></box></geometry>
        </collision>

        <!-- Board base (brown surround) -->
        <visual name="board_base">
          <pose>0.0225 0.0225 0 0 0 0</pose>
          <geometry><box><size>0.375 0.375 0.02</size></box></geometry>
          <material>
            <ambient>0.4 0.25 0.1 1</ambient>
            <diffuse>0.4 0.25 0.1 1</diffuse>
          </material>
        </visual>

        <!-- ── Rank 1 (rank_idx=0, x_rel=-0.135) ── -->
        <visual name="sq_a1"><pose>-0.135 -0.135 0.011 0 0 0</pose><geometry><box><size>0.044 0.044 0.001</size></box></geometry><material><ambient>0.95 0.95 0.85 1</ambient><diffuse>0.95 0.95 0.85 1</diffuse></material></visual>
        <visual name="sq_b1"><pose>-0.135 -0.090 0.011 0 0 0</pose><geometry><box><size>0.044 0.044 0.001</size></box></geometry><material><ambient>0.15 0.10 0.05 1</ambient><diffuse>0.15 0.10 0.05 1</diffuse></material></visual>
        <visual name="sq_c1"><pose>-0.135 -0.045 0.011 0 0 0</pose><geometry><box><size>0.044 0.044 0.001</size></box></geometry><material><ambient>0.95 0.95 0.85 1</ambient><diffuse>0.95 0.95 0.85 1</diffuse></material></visual>
        <visual name="sq_d1"><pose>-0.135  0.000 0.011 0 0 0</pose><geometry><box><size>0.044 0.044 0.001</size></box></geometry><material><ambient>0.15 0.10 0.05 1</ambient><diffuse>0.15 0.10 0.05 1</diffuse></material></visual>

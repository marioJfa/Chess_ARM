<?xml version="1.0" ?>
<robot name="robot_arm">

  <!-- ARM group — chain from base to tool0, MoveIt uses tool0 as IK tip -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <!-- GRIPPER group — 3 fingers commanded separately -->
  <group name="gripper">
    <joint name="finger_1_joint"/>
    <joint name="finger_2_joint"/>
    <joint name="finger_3_joint"/>
  </group>

  <!-- NAMED POSES -->
  <group_state name="home" group="arm">
    <joint name="base_yaw"       value="0"/>
    <joint name="shoulder_roll"  value="0"/>
    <joint name="shoulder_pitch" value="0"/>
    <joint name="elbow_pitch"    value="0"/>
  </group_state>

  <group_state name="reach" group="arm">
    <joint name="base_yaw"       value="0"/>
    <joint name="shoulder_roll"  value="0"/>
    <joint name="shoulder_pitch" value="1.047"/>
    <joint name="elbow_pitch"    value="-0.524"/>
  </group_state>

  <group_state name="pick" group="arm">
    <joint name="base_yaw"       value="0.524"/>
    <joint name="shoulder_roll"  value="0.175"/>
    <joint name="shoulder_pitch" value="1.222"/>
    <joint name="elbow_pitch"    value="-0.873"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="finger_1_joint" value="0"/>
    <joint name="finger_2_joint" value="0"/>
    <joint name="finger_3_joint" value="0"/>
  </group_state>

  <group_state name="closed" group="gripper">
    <joint name="finger_1_joint" value="1.2217"/>
    <joint name="finger_2_joint" value="1.2217"/>
    <joint name="finger_3_joint" value="1.2217"/>
  </group_state>

  <!-- DISABLE COLLISIONS -->
  <disable_collisions link1="world"              link2="base_link"          reason="Adjacent"/>
  <disable_collisions link1="base_link"          link2="shoulder_roll_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_roll_link" link2="upper_arm"          reason="Adjacent"/>
  <disable_collisions link1="upper_arm"          link2="forearm"            reason="Adjacent"/>
  <disable_collisions link1="forearm"            link2="wrist_link"         reason="Adjacent"/>
  <disable_collisions link1="wrist_link"         link2="finger_1"           reason="Adjacent"/>
  <disable_collisions link1="wrist_link"         link2="finger_2"           reason="Adjacent"/>
  <disable_collisions link1="wrist_link"         link2="finger_3"           reason="Adjacent"/>
  <disable_collisions link1="wrist_link"         link2="tool0"              reason="Adjacent"/>
  <disable_collisions link1="wrist_link"         link2="camera_link"        reason="Adjacent"/>
  <disable_collisions link1="camera_link"        link2="finger_1"           reason="Never"/>
  <disable_collisions link1="camera_link"        link2="finger_2"           reason="Never"/>
  <disable_collisions link1="camera_link"        link2="finger_3"           reason="Never"/>
  <disable_collisions link1="camera_link"        link2="tool0"              reason="Never"/>
  <disable_collisions link1="base_link"          link2="upper_arm"          reason="Never"/>
  <disable_collisions link1="shoulder_roll_link" link2="forearm"            reason="Never"/>
  <disable_collisions link1="finger_1"           link2="finger_2"           reason="Never"/>
  <disable_collisions link1="finger_1"           link2="finger_3"           reason="Never"/>
  <disable_collisions link1="finger_2"           link2="finger_3"           reason="Never"/>

</robot>
